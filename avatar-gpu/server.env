# Picture size on the wire. The site is reached through a Tailscale Funnel, which carried only
# about 1.8 Mbit/s to the user's PC when measured: at the default 2500 the video arrived slower than
# it plays. 1100 with crf 21 halves the pieces.
AVATAR_KBPS=1800
AVATAR_X264_CRF=18
# Minutes of nobody making her speak before everything stops and the box pauses (0 = never).
AVATAR_IDLE_MINUTES=30
# The redrawn face is sharpened a little more than the default (0.5): it is small in the picture.
AVATAR_SHARPEN=0.8
