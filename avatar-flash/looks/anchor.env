# The news anchor: navy-blue suit, white shirt, a TV studio behind her, close-up.
# start.sh reads this when FLASH_LOOK=anchor. The picture is 1664x1248, so that the 960x720 frames
# are a whole 15/26 of it; the square (468,52, 754 wide) holds her head and the top of her shoulders.
FLASH_PICTURE="$HERE/looks/anchor.jpg"
FLASH_BOX=468,52,754
FLASH_OWN_LOOK=1
FLASH_BADGE=news
