# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-prod/

# copied from node_modules by scripts/copy-pdfjs.mjs
/public/pdfjs/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sample clips made while testing
/samples/

# avatar: large working files stay out of git (scripts and references are kept)
/avatar-build/video/
/avatar-build/renders/
/avatar-build/looks/
/avatar-build/reference/*.png
/public/avatar/head/sample.zip
/avatar-build/lam/out/
/avatar-build/measure/out/
/avatar-build/measure/node_modules/

# Python caches (avatar-flash/*.py run here)
__pycache__/
*.pyc
