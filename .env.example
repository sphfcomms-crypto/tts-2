# Copy this file to .env and fill in the key.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: lock the public site. Every visitor is asked for this password.
# APP_PASSWORD=

# Optional: usage caps on the public server (defaults shown).
# LIMIT_SPEECH_PER_DAY=500
# LIMIT_SPEECH_PER_VISITOR_HOUR=40
# LIMIT_CALL_PER_DAY=60
# LIMIT_CALL_PER_VISITOR_HOUR=6
# CALL_MAX_MINUTES=10
# USAGE_LIMITS=off

# Optional: the photo-real video avatar. A long random secret shared with the
# GPU box that draws her (see avatar-gpu/README.md). Without it she is shown
# as the 3D character only.
# AVATAR_GPU_KEY=
